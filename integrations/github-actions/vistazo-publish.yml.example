# PLANTILLA (inactiva: renómbrala a .yml en TU repo solo cuando lo autorices).
# Publica una revisión en Vistazo cuando una PR lleva la etiqueta "visual-review".
name: vistazo-publish
on:
  pull_request:
    types: [labeled, synchronize]
jobs:
  publish:
    if: contains(github.event.pull_request.labels.*.name, 'visual-review')
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: 22 }
      # 1) Tu paso de preview (web: deploy de preview; nativo: OTA por rama) → exporta PREVIEW_URL
      # 2) Tu paso de capturas (web: npx vistazo publish --capture; nativo: runner → ./capturas)
      - name: Publicar en Vistazo
        env:
          VISTAZO_URL: ${{ secrets.VISTAZO_URL }}
          VISTAZO_PROJECT: ${{ secrets.VISTAZO_PROJECT }}
          VISTAZO_API_KEY: ${{ secrets.VISTAZO_API_KEY }}
        run: |
          npx vistazo publish --config vistazo.config.json --assets ./capturas \
            --title "PR #${{ github.event.pull_request.number }}: ${{ github.event.pull_request.title }}" \
            --qr "$PREVIEW_URL" --meta pr=${{ github.event.pull_request.number }} --meta commit=${{ github.sha }}
