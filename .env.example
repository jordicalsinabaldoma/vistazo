# Copia este fichero a .env.local y rellénalo. Nunca subas .env.local.
# En Vercel, pon estas variables en el proyecto (Settings → Environment Variables).

# Firma de las sesiones (JWT). Genera uno largo: openssl rand -base64 48
SESSION_SECRET=

# Service account de Firebase en base64 (solo necesita roles/datastore.user):
#   base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_B64=

# Vercel Blob privado (capturas y vídeos). Lo crea `vercel blob` / el panel de Vercel.
BLOB_READ_WRITE_TOKEN=

# Desarrollo local con el emulador de Firestore (en vez de la service account):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# FIREBASE_PROJECT_ID=vistazo-local

# CLI / MCP (en la máquina del agente, no en el servidor):
# VISTAZO_URL=https://tu-vistazo.example
# VISTAZO_PROJECT=<id de la app>
# VISTAZO_API_KEY=vzk_...
