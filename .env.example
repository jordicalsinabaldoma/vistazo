# Copy this file to .env.local and fill it in. Never commit .env.local.
# On Vercel, set these variables on the project (Settings → Environment Variables).

# Session signing key (JWT). Generate a long one: openssl rand -base64 48
SESSION_SECRET=

# Firebase service account as base64 (it only needs roles/datastore.user):
#   base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_B64=

# Private Vercel Blob (screenshots and videos). Create it with `vercel blob` or the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=

# Local development with the Firestore emulator (instead of the service account):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# FIREBASE_PROJECT_ID=vistazo-local

# CLI / MCP (on the agent's machine, not on the server):
# VISTAZO_URL=https://your-vistazo.example
# VISTAZO_PROJECT=<app id>
# VISTAZO_API_KEY=vzk_...
