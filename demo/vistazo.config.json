{
  "$comment": "Flows of the fictional Brasa app. A person writes the plain-language descriptions; the agent translates them into actions. Secrets only through ${env:…}.",
  "baseUrl": "https://brasa-demo-murex.vercel.app/v1/",
  "allowHosts": ["brasa-demo-murex.vercel.app", "localhost", "127.0.0.1"],
  "viewport": { "width": 1280, "height": 800 },
  "mask": ["[data-sensitive]"],
  "video": true,
  "flows": [
    {
      "key": "compra",
      "title": "Customer creates an order and reaches checkout",
      "description": "Sign in as a customer, create an order and reach checkout",
      "steps": [
        { "key": "login", "title": "Sign in", "actions": [{ "goto": "index.html" }] },
        {
          "key": "catalogo",
          "title": "Catalog",
          "actions": [
            { "fill": ["[data-testid=email]", "cliente@brasa.test"] },
            { "fill": ["[data-testid=password]", "${env:BRASA_DEMO_PASSWORD}"] },
            { "click": "[data-testid=login]" },
            { "waitFor": "[data-testid=product-p1]" }
          ]
        },
        {
          "key": "carrito",
          "title": "Cart with two coffees",
          "actions": [
            { "click": "[data-testid=add-p1]" },
            { "click": "[data-testid=add-p3]" },
            { "click": "[data-testid=nav-cart]" },
            { "waitFor": "[data-testid=total]" }
          ]
        },
        {
          "key": "pago",
          "title": "Checkout",
          "notes": "The card number is masked in the screenshot (mask).",
          "actions": [
            { "click": "[data-testid=checkout]" },
            { "fill": ["[data-testid=card-name]", "Lucía Demo"] },
            { "fill": ["[data-testid=card-number]", "4242 4242 4242 4242"] }
          ]
        }
      ]
    },
    {
      "key": "login-error",
      "title": "Wrong password",
      "description": "Try to sign in with a wrong password and check that the error is clear",
      "steps": [
        {
          "key": "error",
          "title": "Error message",
          "actions": [
            { "goto": "index.html" },
            { "fill": ["[data-testid=email]", "cliente@brasa.test"] },
            { "fill": ["[data-testid=password]", "mal"] },
            { "click": "[data-testid=login]" },
            { "waitFor": "#err" }
          ]
        }
      ]
    }
  ]
}
